-- Colin's Ultra-Light Stealth Script
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- Настройки: сюда впиши точные имена ремоутов, если знаешь
-- Если не знаешь, скрипт попробует найти их сам
local CASH_AMOUNT = 999999 

local function findAndFire()
    local events = ReplicatedStorage:FindFirstChild("Events") or ReplicatedStorage
    
    -- Ищем ремоуты для награды (один раз, без циклов)
    for _, obj in ipairs(events:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local name = string.lower(obj.Name)
            -- Ищем что-то связанное с наградой за действия
            if string.find(name, "reward") or string.find(name, "cash") or string.find(name, "money") or string.find(name, "kill") or string.find(name, "capture") then
                -- Отправляем один раз
                pcall(function()
                    obj:FireServer(CASH_AMOUNT)
                    obj:FireServer("Reward", CASH_AMOUNT)
                end)
                -- Выходим после первого успешного вызова, чтобы не спамить
                break 
            end
        end
    end
end

-- Слушаем нажатие F5
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F5 then
        findAndFire()
        
        -- Визуальное уведомление (нативное, без GUI)
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Colin Hack",
                Text = "Вызов отправлен.",
                Duration = 2
            })
        end)
    end
end)
