-- 2. Настройка перехватчика (Hook)
local capturedRemote = nil
local capturedArgs = nil

if hookfunction then
    local oldFire = hookfunction(Instance.new("RemoteEvent").FireServer, function(self, ...)
        local args = {...}
        -- Если мы уже нашли ремоут, не перехватываем дальше
        if not capturedRemote then
            -- Пытаемся найти что-то похожее на награду (число в аргументах)
            for _, arg in ipairs(args) do
                if type(arg) == "number" then
                    capturedRemote = self
                    capturedArgs = args
                    
                    -- Обновляем UI
                    status.Text = "Перехвачено: " .. self.Name
                    button.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
                    button.TextColor3 = Color3.fromRGB(255, 255, 255)
                    button.Text = "Отправить накрутку"
                    logOutput.Text = "Ремоут: " .. self.Name .. " | Аргументы: " .. tostring(arg)
                    break
                end
            end
        end
        return oldFire(self, ...)
    end)
else
    status.Text = "Ошибка: твой executor не поддерживает hookfunction."
end

-- 3. Логика отправки
button.MouseButton1Click:Connect(function()
    if not capturedRemote then
        status.Text = "Сначала сделай действие в игре, чтобы я перехватил вызов!"
        return
    end

    local amount = tonumber(inputAmount.Text)
    if not amount then
        status.Text = "Введи число!"
        return
    end

    -- Меняем аргументы: если перехватили число, подменяем его на наше
    local newArgs = {}
    for i, arg in ipairs(capturedArgs) do
        if type(arg) == "number" then
            newArgs[i] = amount -- Подменяем число
        else
            newArgs[i] = arg -- Остальное оставляем как есть
        end
    end

    -- Отправляем ОДИН раз, без циклов, чтобы античит не спалил
    pcall(function()
        capturedRemote:FireServer(unpack(newArgs))
    end)
    
    status.Text = "Отправлено! Жди, не спамь, иначе выкинет."
    button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    button.TextColor3 = Color3.fromRGB(150, 150, 150)
    button.Text = "Ожидание нового действия..."
    
    -- Сбрасываем перехват, чтобы найти следующий вызов
    capturedRemote = nil
    capturedArgs = nil
end)
