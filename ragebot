-- Шаг 2: Безопасный поиск ремоута (без бесконечного WaitForChild)
local function findMoneyRemote()
    local events = ReplicatedStorage:FindFirstChild("Events")
    if not events then return nil end
    
    for _, child in ipairs(events:GetChildren()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            -- Ищем что-то похожее на деньги
            if string.find(string.lower(child.Name), "coin") or 
               string.find(string.lower(child.Name), "cash") or 
               string.find(string.lower(child.Name), "money") or
               string.find(string.lower(child.Name), "balance") then
                return child
            end
        end
    end
    return nil
end

-- Шаг 3: Обработчик кнопки
button.MouseButton1Click:Connect(function()
    local amount = tonumber(input.Text)
    if not amount then
        status.Text = "Ошибка: введи число!"
        return
    end

    local remote = findMoneyRemote()
    if not remote then
        status.Text = "Ремоут с деньгами не найден. Смотри консоль для спая."
        return
    end

    status.Text = "Отправлено в " .. remote.Name .. ": " .. tostring(amount)

    -- Шаг 4: Отправка с защитой от краша
    task.spawn(function()
        pcall(function()
            if remote:IsA("RemoteEvent") then
                -- Если сервер ждет число
                remote:FireServer(amount)
                -- Если сервер ждет таблицу, попробуй: remote:FireServer("currencyReward", {"bucks", amount})
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(amount)
            end
        end)
    end)
end)

-- Шаг 5: RemoteSpy — выводим в консоль все вызовы ремоутов игры
-- Играй 5 секунд, собирай деньги, затем смотри консоль (F9)
local oldFireServer
if hookfunction then
    oldFireServer = hookfunction(Instance.new("RemoteEvent").FireServer, function(self, ...)
        print("[SPY] FireServer:", self:GetFullName(), "...")
        print("[SPY] Аргументы:", ...)
        return oldFireServer(self, ...)
    end)
else
    print("[Colin]: Твой executor не поддерживает hookfunction. Используй RemoteSpy отдельно.")
end
