-- 2. Логика скрытия/разворачивания
local isOpen = true
toggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    if isOpen then
        frame:TweenSize(UDim2.new(0, 320, 0, 260), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        content.Visible = true
        toggleBtn.Text = "-"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    else
        frame:TweenSize(UDim2.new(0, 320, 0, 30), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        content.Visible = false
        toggleBtn.Text = "+"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    end
end)

-- 3. Логика перетаскивания (Drag)
local dragging = false
local dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

topBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

-- 4. Настройка перехватчика (Hook)
local capturedRemote = nil
local capturedArgs = nil

if hookfunction then
    local oldFire = hookfunction(Instance.new("RemoteEvent").FireServer, function(self, ...)
        local args = {...}
        if not capturedRemote then
            for _, arg in ipairs(args) do
                if type(arg) == "number" then
                    capturedRemote = self
                    capturedArgs = args
                    
                    status.Text = "Перехвачено: " .. self.Name
                    button.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
                    button.TextColor3 = Color3.fromRGB(255, 255, 255)
                    button.Text = "Отправить накрутку"
                    logOutput.Text = "Ремоут: " .. self.Name .. " | Аргументы: " .. tostring(arg)
                    break
                end
            end
        end
        return oldFire(self, ...)
    end)
else
    status.Text = "Ошибка: нет hookfunction."
end

-- 5. Логика отправки
button.MouseButton1Click:Connect(function()
    if not capturedRemote then
        status.Text = "Сначала сделай действие в игре!"
        return
    end

    local amount = tonumber(inputAmount.Text)
    if not amount then
        status.Text = "Введи число!"
        return
    end

    local newArgs = {}
    for i, arg in ipairs(capturedArgs) do
        if type(arg) == "number" then
            newArgs[i] = amount
        else
            newArgs[i] = arg
        end
    end

    pcall(function()
        capturedRemote:FireServer(unpack(newArgs))
    end)
    
    status.Text = "Отправлено! Жди, не спамь."
    button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    button.TextColor3 = Color3.fromRGB(150, 150, 150)
    button.Text = "Ожидание нового действия..."
    
    capturedRemote = nil
    capturedArgs = nil
end)
