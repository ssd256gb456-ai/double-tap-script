-- UI Helpers
local function createCheckbox(parent, text, posY, defaultState, settingName)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 20)
    lbl.Position = UDim2.new(0, 10, 0, posY)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = parent

    local cb = Instance.new("TextButton")
    cb.Size = UDim2.new(0, 15, 0, 15)
    cb.Position = UDim2.new(0, -5, 0, 2)
    cb.BackgroundColor3 = defaultState and Color3.fromRGB(100, 200, 255) or Color3.fromRGB(30, 30, 30)
    cb.Text = ""
    cb.Parent = lbl
    Instance.new("UICorner", cb).CornerRadius = UDim.new(0, 2)
    
    cb.MouseButton1Click:Connect(function()
        getgenv().ColinSettings[settingName] = not getgenv().ColinSettings[settingName]
        cb.BackgroundColor3 = getgenv().ColinSettings[settingName] and Color3.fromRGB(100, 200, 255) or Color3.fromRGB(30, 30, 30)
    end)
end

local function createSlider(parent, text, posY, minVal, maxVal, defaultVal, settingName, isFloat)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 20)
    lbl.Position = UDim2.new(0, 10, 0, posY)
    lbl.BackgroundTransparency = 1
    lbl.Text = text .. ": " .. tostring(defaultVal)
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = parent

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -40, 0, 4)
    bar.Position = UDim2.new(0, 10, 0, 20)
    bar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    bar.Parent = lbl
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    local initialPercent = (defaultVal - minVal) / (maxVal - minVal)
    fill.Size = UDim2.new(initialPercent, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(100, 200, 255)
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local function updateSlider(input)
                local mouseX = input.Position.X
                local barAbsolutePos = bar.AbsolutePosition.X
                local barSize = bar.AbsoluteSize.X
                local percent = math.clamp((mouseX - barAbsolutePos) / barSize, 0, 1)
                fill.Size = UDim2.new(percent, 0, 1, 0)
                local val = minVal + (maxVal - minVal) * percent
                if not isFloat then val = math.floor(val) end
                lbl.Text = text .. ": " .. tostring(val)
                getgenv().ColinSettings[settingName] = val
            end
            updateSlider(input)
            local connection
            connection = UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then updateSlider(input) end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    if connection then connection:Disconnect() end
                end
            end)
        end
    end)
end

