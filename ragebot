-- 2. Настройка RemoteSpy для поиска правильного ремоута
local spyLog = {}
local function setupSpy()
    if not hookfunction then 
        status.Text = "Ошибка: нет hookfunction. Используй сторонний RemoteSpy."
        return 
    end
    
    local oldFire = hookfunction(Instance.new("RemoteEvent").FireServer, function(self, ...)
        -- Игнорируем GunFx, чтобы не спамить
        if self.Name ~= "GunFx" then
            local args = {...}
            local argStr = ""
            for i, v in ipairs(args) do
                argStr = argStr .. tostring(v) .. ", "
            end
            table.insert(spyLog, self:GetFullName() .. " -> " .. argStr)
            -- Выводим в консоль (F9)
            print("[SPY] Игра отправила:", self.Name, "| Аргументы:", ...)
        end
        return oldFire(self, ...)
    end)
    
    status.Text = "Spy активен. Сделай действие в игре (купи что-то), затем жми кнопку."
end

-- 3. Функция поиска ремоута
local function findRemote()
    local events = ReplicatedStorage:FindFirstChild("Events")
    if not events then return nil end
    for _, child in ipairs(events:GetChildren()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            local n = string.lower(child.Name)
            if string.find(n, "coin") or string.find(n, "cash") or 
               string.find(n, "money") or string.find(n, "balance") or
               string.find(n, "reward") or string.find(n, "bank") then
                return child
            end
        end
    end
    return nil
end

-- 4. Кнопка
button.MouseButton1Click:Connect(function()
    local amount = tonumber(input.Text)
    if not amount then
        status.Text = "Ошибка: введи число!"
        return
    end

    -- Сначала пробуем найти ремоут по имени
    local remote = findRemote()
    
    -- Если не нашли, пробуем взять из логов Spy
    if not remote and #spyLog > 0 then
        status.Text = "Ремоут не найден по имени. Смотри консоль (F9)."
        for _, log in ipairs(spyLog) do
            print("[LOG]", log)
        end
        return
    end

    if not remote then
        status.Text = "Ремоут не найден. Сделай покупку, чтобы Spy его увидел."
        return
    end

    status.Text = "Отправка в " .. remote.Name .. "..."
    
    -- Отправляем один раз, без циклов
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(amount) 
        elseif remote:IsA("RemoteFunction") then
            remote:InvokeServer(amount)
        end
        status.Text = "Успешно отправлено: " .. tostring(amount)
    end)
end)

-- Запускаем Spy
setupSpy()
