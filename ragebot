local function createCheckbox(parent, text, posY, defaultState, settingName)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 20)
    lbl.Position = UDim2.new(0, 10, 0, posY)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = parent

    local cb = Instance.new("TextButton")
    cb.Size = UDim2.new(0, 15, 0, 15)
    cb.Position = UDim2.new(0, -5, 0, 2)
    cb.BackgroundColor3 = defaultState and Color3.fromRGB(100, 200, 255) or Color3.fromRGB(30, 30, 30)
    cb.Text = ""
    cb.Parent = lbl
    Instance.new("UICorner", cb).CornerRadius = UDim.new(0, 2)
    
    cb.MouseButton1Click:Connect(function()
        getgenv().ColinSettings[settingName] = not getgenv().ColinSettings[settingName]
        cb.BackgroundColor3 = getgenv().ColinSettings[settingName] and Color3.fromRGB(100, 200, 255) or Color3.fromRGB(30, 30, 30)
    end)
end

