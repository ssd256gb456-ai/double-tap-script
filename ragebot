-- Colin's RP Money Farmer (Safe VirtualUser Version)
local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")
local StarterGui = game:GetService("StarterGui")
local player = Players.LocalPlayer

-- Настройки
local DELAY = 2 -- Задержка между действиями (в секундах)
local USE_KEY_E = true -- Если на работе нужно нажимать E, оставь true. Если кликать мышкой - false.

local function notify(text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "AutoFarm";
            Text = text;
            Duration = 3
        })
    end)
end

notify("Автофарм денег запущен. Встань на рабочую точку!")

-- Запускаем цикл
task.spawn(function()
    while task.wait(DELAY) do
        pcall(function()
            if USE_KEY_E then
                -- Имитация нажатия клавиши E (взаимодействие)
                VirtualUser:CaptureController()
                VirtualUser:ButtonE(true)
                task.wait(0.1)
                VirtualUser:ButtonE(false)
            else
                -- Имитация клика мышью
                VirtualUser:CaptureController()
                VirtualUser:ClickButton1(Vector2.new(0, 0))
            end
        end)
    end
end)
