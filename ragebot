-- Colin's Blind Remote Bomber & GUI
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- 1. Создаем GUI
local gui = Instance.new("ScreenGui")
gui.Name = "ColinBlindBomber"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 300, 0, 200)
frame.Position = UDim2.new(0.5, -150, 0.5, -100)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundTransparency = 1
title.Text = "Слепой бомбер (Colin)"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.Parent = frame

-- Поле суммы
local inputAmount = Instance.new("TextBox")
inputAmount.Size = UDim2.new(1, -20, 0, 36)
inputAmount.Position = UDim2.new(0, 10, 0, 40)
inputAmount.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
inputAmount.TextColor3 = Color3.fromRGB(255, 255, 255)
inputAmount.PlaceholderText = "Сумма (999999)"
inputAmount.Text = "999999"
inputAmount.Parent = frame
Instance.new("UICorner", inputAmount).CornerRadius = UDim.new(0, 6)

-- Кнопка
local button = Instance.new("TextButton")
button.Size = UDim2.new(1, -20, 0, 44)
button.Position = UDim2.new(0, 10, 0, 85)
button.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Text = "Бомбить все ремоуты"
button.Font = Enum.Font.GothamBold
button.TextSize = 15
button.Parent = frame
Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

-- Статус
local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 50)
status.Position = UDim2.new(0, 10, 0, 140)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.fromRGB(180, 180, 180)
status.Text = "Жди. Я пробью все ремоуты."
status.Font = Enum.Font.Gotham
status.TextSize = 13
status.TextWrapped = true
status.Parent = frame

-- 2. Логика поиска и бомбежки
button.MouseButton1Click:Connect(function()
    local amount = tonumber(inputAmount.Text)
    if not amount then
        status.Text = "Ошибка: введи число!"
        return
    end

    status.Text = "Поиск ремоутов и отправка..."
    
    local count = 0
    local hitLog = {}

    -- Ищем все ремоуты во всей игре (включая ReplicatedStorage и Workspace)
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            -- Пытаемся отправить сумму
            pcall(function()
                obj:FireServer(amount)
                -- На всякий случай шлем еще и таблицу (некоторые игры ждут таблицу)
                obj:FireServer("currency", amount)
                obj:FireServer({amount = amount})
            end)
            count = count + 1
            table.insert(hitLog, obj:GetFullName())
        elseif obj:IsA("RemoteFunction") then
            -- Для RemoteFunction вызываем
            pcall(function()
                obj:InvokeServer(amount)
            end)
            count = count + 1
            table.insert(hitLog, obj:GetFullName())
        end
    end

    -- Выводим в консоль, куда стреляли
    print("[Colin Bomber] Отправлено в " .. count .. " ремоутов:")
    for _, v in ipairs(hitLog) do
        print(" -> " .. v)
    end

    status.Text = "Отправлено в " .. count .. " ремоутов. Проверь баланс."
end)
