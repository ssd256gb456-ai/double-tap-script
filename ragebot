-- 2. Логика скрытия/разворачивания
local isOpen = true
toggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    if isOpen then
        frame:TweenSize(UDim2.new(0, 320, 0, 280), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        content.Visible = true
        toggleBtn.Text = "-"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    else
        frame:TweenSize(UDim2.new(0, 320, 0, 30), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
        content.Visible = false
        toggleBtn.Text = "+"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    end
end)

-- 3. Логика перетаскивания
local dragging = false
local dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

topBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

-- 4. Безопасная отправка с задержкой
button.MouseButton1Click:Connect(function()
    local amount = tonumber(inputAmount.Text)
    if not amount then
        status.Text = "Ошибка: введи число!"
        return
    end

    status.Text = "Перебор ремоутов..."
    logOutput.Text = "Начинаю тихий перебор. Жди."
    
    local commonNames = {
        "AddCoins", "GiveCash", "Cash", "Coins", "Money", 
        "AddCash", "GiveMoney", "UpdateBalance", "Reward", 
        "Buy", "Sell", "Purchase", "Claim"
    }
    
    local eventsFolder = ReplicatedStorage:FindFirstChild("Events") or ReplicatedStorage
    
    task.spawn(function()
        for _, name in ipairs(commonNames) do
            local remote = eventsFolder:FindFirstChild(name, true) -- true = рекурсивный поиск
            if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
                status.Text = "Проверяю: " .. name
                logOutput.Text = "Стреляю в: " .. name
                
                pcall(function()
                    if remote:IsA("RemoteEvent") then
                        remote:FireServer(amount)
                        remote:FireServer("currency", amount)
                        remote:FireServer({amount = amount})
                    elseif remote:IsA("RemoteFunction") then
                        remote:InvokeServer(amount)
                    end
                end)
                
                task.wait(1) -- Задержка 1 секунда, чтобы античит не крашнул
            end
        end
        status.Text = "Перебор завершен."
        logOutput.Text = "Все имена проверены. Если денег нет — сервер защищен."
    end)
end)
