-- ESP (Drawing)
local ESP_Objects = {}

local function createESP(player)
    if player == LocalPlayer then return end
    local box = Drawing.new("Square")
    box.Visible = false
    box.Thickness = 1
    box.Filled = false
    local name = Drawing.new("Text")
    name.Visible = false
    name.Size = 14
    name.Center = true
    name.Outline = true
    ESP_Objects[player] = {Box = box, Name = name}
end

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(function(p)
    if ESP_Objects[p] then
        ESP_Objects[p].Box:Remove()
        ESP_Objects[p].Name:Remove()
        ESP_Objects[p] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    for player, esp in pairs(ESP_Objects) do
        if getgenv().ColinSettings.ESP_ENABLED and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("HumanoidRootPart") then
            local head = player.Character.Head
            local root = player.Character.HumanoidRootPart
            local headScreen, onScreen = Camera:WorldToViewportPoint(head.Position)
            local rootScreen, _ = Camera:WorldToViewportPoint(root.Position)
            
            if onScreen then
                local height = math.abs(headScreen.Y - rootScreen.Y) * 2
                local width = height / 2
                esp.Box.Size = Vector2.new(width, height)
                esp.Box.Position = Vector2.new(headScreen.X - width/2, headScreen.Y - height/4)
                esp.Box.Visible = true
                esp.Box.Color = (player.Team == LocalPlayer.Team) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
                
                esp.Name.Text = player.Name
                esp.Name.Position = Vector2.new(headScreen.X, headScreen.Y - 20)
                esp.Name.Visible = true
            else
                esp.Box.Visible = false
                esp.Name.Visible = false
            end
        else
            esp.Box.Visible = false
            esp.Name.Visible = false
        end
    end
end)

-- Aimbot
RunService.RenderStepped:Connect(function()
    if not getgenv().ColinSettings.AIMBOT_ENABLED then return end
    local closest = nil
    local shortestDistance = getgenv().ColinSettings.AIM_FOV
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChildOfClass("Humanoid") and player.Character.Humanoid.Health > 0 then
            if getgenv().ColinSettings.TEAM_CHECK and player.Team == LocalPlayer.Team then continue end
            local headScreen, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
            if onScreen then
                local distance = (Vector2.new(headScreen.X, headScreen.Y) - mousePos).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closest = player.Character.Head
                end
            end
        end
    end

    if closest and mousemoverel then
        local targetPos = Camera:WorldToViewportPoint(closest.Position)
        local newMousePos = Vector2.new(targetPos.X, targetPos.Y)
        local delta = (newMousePos - mousePos) * getgenv().ColinSettings.AIM_SMOOTH
        mousemoverel(delta.X, delta.Y)
    end
end)
