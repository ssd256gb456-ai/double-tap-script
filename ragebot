-- Colin's GUI money hack script
-- LocalScript / executor. Change the remote path and arg format to match the target game.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Шаг 1: Укажи RemoteEvent, который выдаёт валюту
local remote = ReplicatedStorage:WaitForChild("Events"):WaitForChild("coins") -- поменяй путь

-- Шаг 2: Создаём ScreenGui
local gui = Instance.new("ScreenGui")
gui.Name = "ColinHackMenu"
gui.ResetOnSpawn = false
gui.Parent = playerGui

-- Шаг 3: Создаём фрейм меню
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 160)
frame.Position = UDim2.new(0.5, -130, 0.5, -80)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = frame

-- Шаг 4: Поле для ввода числа
local input = Instance.new("TextBox")
input.Size = UDim2.new(1, -20, 0, 36)
input.Position = UDim2.new(0, 10, 0, 10)
input.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
input.TextColor3 = Color3.fromRGB(255, 255, 255)
input.PlaceholderText = "Введи сумму"
input.Text = "999999"
input.ClearTextOnFocus = false
input.Parent = frame

local inputCorner = Instance.new("UICorner")
inputCorner.CornerRadius = UDim.new(0, 6)
inputCorner.Parent = input

-- Шаг 5: Кнопка "Хакнуть / Взломать / Взорвать"
local button = Instance.new("TextButton")
button.Size = UDim2.new(1, -20, 0, 44)
button.Position = UDim2.new(0, 10, 0, 56)
button.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Text = "Хакнуть / Взломать / Взорвать"
button.Font = Enum.Font.GothamBold
button.TextSize = 15
button.Parent = frame

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 6)
buttonCorner.Parent = button

-- Шаг 6: Статус-лейбл
local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 30)
status.Position = UDim2.new(0, 10, 0, 108)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.fromRGB(180, 180, 180)
status.Text = "Готов"
status.Font = Enum.Font.Gotham
status.TextSize = 14
status.Parent = frame

-- Шаг 7: Обработчик кнопки — читаем число и шлём в ремоут
button.MouseButton1Click:Connect(function()
    local amount = tonumber(input.Text)
    if not amount then
        status.Text = "Введи число"
        return
    end
    status.Text = "Отправлено: " .. tostring(amount)

    -- Шаг 8: Формат аргументов — поменяй под игру (число или таблица)
    -- Пример 1: remote:FireServer(amount)
    -- Пример 2: remote:FireServer("currencyReward", {"bucks", amount})
    remote:FireServer(amount)
end)
